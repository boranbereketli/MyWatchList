PORT=3000

CORS_ORIGIN=http://localhost:5173

# PostgreSQL. This user must be allowed to create databases: the server creates PGDATABASE on first start.
PGUSER=postgres
PGPASSWORD=your-postgres-password
PGHOST=localhost
PGPORT=5432
PGDATABASE=mywatchlist

# Free key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your-tmdb-api-key

# Required, at least 16 random characters. The server refuses to start without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
